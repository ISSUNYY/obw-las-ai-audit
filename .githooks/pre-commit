#!/bin/sh

python_bin="$(git config --get obw.python 2>/dev/null || true)"
if [ -z "$python_bin" ]; then
    python_bin="${PYTHON:-python}"
fi

required="$(git config --bool --get obw.lunaRequired 2>/dev/null || true)"
luna_option=""
if [ "$required" = "true" ]; then
    luna_option="--require-luna"
fi

PYTHONUTF8=1 "$python_bin" scripts/luna.py $luna_option
